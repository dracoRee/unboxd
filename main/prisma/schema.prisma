generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  name              String?
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  bio               String?
  isVerified        Boolean           @default(false)
  profilePicture    String?
  username          String            @unique
  createdAt         DateTime          @default(now())
  phoneVerified     Boolean           @default(false)
  ratingAvg         Float             @default(0)
  ratingCount       Int               @default(0)
  collectibles      Collectible[]
  messages          Message[]
  publicUser        PublicUser?
  proposedTrades    Trade[]           @relation("ProposedTrades")
  receivedTrades    Trade[]           @relation("ReceivedTrades")
  collection        UserCollectible[]
  ratingsReceived   UserRating[]      @relation("RatingsReceived")
  ratingsGiven      UserRating[]      @relation("RatingsGiven")
  wishlist          WishlistItem[]
  userConversations Conversation[]    @relation("ConversationToUser")
  User_A            User[]            @relation("UserFollows")
  User_B            User[]            @relation("UserFollows")
}

model PublicUser {
  id             Int           @id
  name           String
  bio            String?
  profilePicture String?
  isVerified     Boolean       @default(false)
  username       String        @unique
  user           User          @relation(fields: [id], references: [id])
  listings       UserListing[]
}

model Series {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  imageUrl         String?
  totalItems       Int?
  items            Collectible[]
  userCollectibles UserCollectible[]
}

model Collectible {
  id             Int                @id @default(autoincrement())
  name           String
  rarity         String
  referenceValue Float
  seriesId       Int
  condition      String?
  createdAt      DateTime           @default(now())
  description    String?
  updatedAt      DateTime           @default(now()) @updatedAt
  userId         Int?
  series         Series             @relation(fields: [seriesId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])
  trades         Trade[]
  offeredIn      TradeOfferedItem[]
  userListings   UserListing[]
}

model UserCollectible {
  id             Int               @id @default(autoincrement())
  userId         Int
  seriesId       Int
  imageUrl       String
  name           String?
  condition      ListingCondition? @default(BRAND_NEW)
  demoVideoUrl   String?
  receiptUrl     String?
  referenceValue Float?
  serialNumber   String?
  series         Series            @relation(fields: [seriesId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
}

model UserListing {
  id                  Int              @id @default(autoincrement())
  userId              Int
  collectibleId       Int?
  serialNumber        String
  demoVideoUrl        String
  receiptUrl          String
  imageUrl            String?
  isAvailableForTrade Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  condition           ListingCondition @default(BRAND_NEW)
  description         String           @default("No description provided")
  title               String           @default("Untitled Listing")
  dealMethods         String[]         @default([])
  referenceValue      Float?
  seriesName          String?
  status              ListingStatus    @default(AVAILABLE)
  collectible         Collectible?     @relation(fields: [collectibleId], references: [id])
  user                PublicUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistedBy        WishlistItem[]

  @@index([userId])
  @@index([collectibleId])
  @@index([isAvailableForTrade])
  @@index([status])
}

model Trade {
  id            Int                @id @default(autoincrement())
  proposerId    Int
  receiverId    Int
  targetItemId  Int
  status        String             @default("PENDING")
  cashAmount    Float              @default(0)
  buyerPaysCash Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  messages      Message[]
  proposer      User               @relation("ProposedTrades", fields: [proposerId], references: [id])
  receiver      User               @relation("ReceivedTrades", fields: [receiverId], references: [id])
  targetItem    Collectible        @relation(fields: [targetItemId], references: [id])
  offeredItems  TradeOfferedItem[]
  ratings       UserRating[]
}

model TradeOfferedItem {
  id            Int         @id @default(autoincrement())
  tradeId       Int
  collectibleId Int
  collectible   Collectible @relation(fields: [collectibleId], references: [id])
  trade         Trade       @relation(fields: [tradeId], references: [id])
}

model WishlistItem {
  id        Int         @id @default(autoincrement())
  userId    Int
  listingId Int
  listing   UserListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  users     User[]    @relation("ConversationToUser")
}

model Message {
  id             Int           @id @default(autoincrement())
  tradeId        Int?
  senderId       Int
  content        String
  createdAt      DateTime      @default(now())
  conversationId Int?
  imageUrl       String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  sender         User          @relation(fields: [senderId], references: [id])
  trade          Trade?        @relation(fields: [tradeId], references: [id])
}

model UserRating {
  id        Int      @id @default(autoincrement())
  tradeId   Int
  raterId   Int
  rateeId   Int
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  ratee     User     @relation("RatingsReceived", fields: [rateeId], references: [id])
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id])
  trade     Trade    @relation(fields: [tradeId], references: [id])

  @@unique([tradeId, raterId])
  @@index([rateeId])
}

enum ListingStatus {
  AVAILABLE
  SOLD
}

enum ListingCondition {
  BRAND_NEW
  LIKE_NEW
  LIGHTLY_USED
  WELL_USED
  HEAVILY_USED
}
