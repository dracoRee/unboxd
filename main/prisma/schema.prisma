generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  name              String?
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  bio               String?
  profilePicture    String?
  isVerified        Boolean           @default(false)
  messages          Message[]
  publicUser        PublicUser?
  proposedTrades    Trade[]           @relation("ProposedTrades")
  receivedTrades    Trade[]           @relation("ReceivedTrades")
  collection        UserCollectible[]
  collectibles      Collectible[]
  wishlist          WishlistItem[]
  listings          UserListing[]
  userConversations Conversation[]    @relation("ConversationToUser")
  following         User[]            @relation("UserFollows")
  followedBy        User[]            @relation("UserFollows")
}

model PublicUser {
  id             Int     @id
  name           String
  bio            String?
  profilePicture String?
  isVerified     Boolean @default(false)
  user           User    @relation(fields: [id], references: [id])
}

model Series {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  imageUrl         String?
  totalItems       Int?
  items            Collectible[]
  userCollectibles UserCollectible[]
}

model Collectible {
  id              Int                @id @default(autoincrement())
  name            String
  rarity          String
  description     String?
  condition       String?
  referenceValue  Float
  imageUrl        String
  seriesId        Int
  series          Series             @relation(fields: [seriesId], references: [id])
  trades          Trade[]
  offeredIn       TradeOfferedItem[]
  wishlistedBy    WishlistItem[]
  userListings    UserListing[]
  userId          Int?
  user            User?              @relation(fields: [userId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
}



model UserCollectible {
  id       Int    @id @default(autoincrement())
  userId   Int
  seriesId Int
  name          String?
  imageUrl      String
  series   Series @relation(fields: [seriesId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model UserListing {
  id                  Int         @id @default(autoincrement())
  userId              Int
  collectibleId       Int?
  title               String              @default("Untitled Listing")
  serialNumber        String
  demoVideoUrl        String
  receiptUrl          String
  imageUrl            String?
  description         String              @default("No description provided")

  condition           ListingCondition    @default(BRAND_NEW)
  
  referenceValue      Float?
  dealMethods         String[]            @default([])
  seriesName          String?

  isAvailableForTrade Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  user                User        @relation(fields: [userId], references: [id])
  collectible         Collectible? @relation(fields: [collectibleId], references: [id])
  
  @@index([userId])
  @@index([collectibleId])
  @@index([isAvailableForTrade])
}

model Trade {
  id           Int                @id @default(autoincrement())
  proposerId   Int
  receiverId   Int
  targetItemId Int
  status       String             @default("PENDING")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     Message[]
  proposer     User               @relation("ProposedTrades", fields: [proposerId], references: [id])
  receiver     User               @relation("ReceivedTrades", fields: [receiverId], references: [id])
  targetItem   Collectible        @relation(fields: [targetItemId], references: [id])
  offeredItems TradeOfferedItem[]
}

model TradeOfferedItem {
  id            Int         @id @default(autoincrement())
  tradeId       Int
  collectibleId Int
  collectible   Collectible @relation(fields: [collectibleId], references: [id])
  trade         Trade       @relation(fields: [tradeId], references: [id])
}

model WishlistItem {
  id            Int         @id @default(autoincrement())
  userId        Int
  collectibleId Int
  collectible   Collectible @relation(fields: [collectibleId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, collectibleId])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  users     User[]    @relation("ConversationToUser")
}

model Message {
  id             Int           @id @default(autoincrement())
  tradeId        Int?
  senderId       Int
  content        String
  imageUrl       String?
  createdAt      DateTime      @default(now())
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  sender         User          @relation(fields: [senderId], references: [id])
  trade          Trade?        @relation(fields: [tradeId], references: [id])
}

enum ListingCondition {
  BRAND_NEW
  LIKE_NEW
  LIGHTLY_USED
  WELL_USED
  HEAVILY_USED
}
