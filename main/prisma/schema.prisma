generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  name              String?
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  bio               String?
  profilePicture    String?
  messages          Message[]
  proposedTrades    Trade[]           @relation("ProposedTrades")
  receivedTrades    Trade[]           @relation("ReceivedTrades")
  collection        UserCollectible[]
  wishlist          WishlistItem[]
  userConversations Conversation[]    @relation("ConversationToUser")
  User_A            User[]            @relation("UserFollows")
  User_B            User[]            @relation("UserFollows")
  isVerified     Boolean @default(false)
  publicUser        PublicUser?
}

model PublicUser {
  id             Int     @id
  user           User    @relation(fields: [id], references: [id])
  name           String
  bio            String?
  profilePicture String?
}

model Series {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  imageUrl    String?
  totalItems  Int?
  items       Collectible[]
  userCollectibles UserCollectible[]
}

model Collectible {
  id             Int                @id @default(autoincrement())
  name           String
  rarity         String
  referenceValue Float
  imageUrl       String
  seriesId       Int
  series         Series             @relation(fields: [seriesId], references: [id])
  trades         Trade[]
  offeredIn      TradeOfferedItem[]
  wishlistedBy   WishlistItem[]
}

model UserCollectible {
  id            Int         @id @default(autoincrement())
  userId        Int
  seriesId      Int 
  series        Series      @relation(fields: [seriesId], references: [id]) 
  user          User        @relation(fields: [userId], references: [id])
}

model Trade {
  id           Int                @id @default(autoincrement())
  proposerId   Int
  receiverId   Int
  targetItemId Int
  status       String             @default("PENDING")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     Message[]
  proposer     User               @relation("ProposedTrades", fields: [proposerId], references: [id])
  receiver     User               @relation("ReceivedTrades", fields: [receiverId], references: [id])
  targetItem   Collectible        @relation(fields: [targetItemId], references: [id])
  offeredItems TradeOfferedItem[]
}

model TradeOfferedItem {
  id            Int         @id @default(autoincrement())
  tradeId       Int
  collectibleId Int
  collectible   Collectible @relation(fields: [collectibleId], references: [id])
  trade         Trade       @relation(fields: [tradeId], references: [id])
}

model WishlistItem {
  id            Int         @id @default(autoincrement())
  userId        Int
  collectibleId Int
  collectible   Collectible @relation(fields: [collectibleId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, collectibleId])
}

model Conversation {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  users     User[]    @relation("ConversationToUser")
}

model Message {
  id             Int           @id @default(autoincrement())
  tradeId        Int?
  senderId       Int
  content        String
  createdAt      DateTime      @default(now())
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  sender         User          @relation(fields: [senderId], references: [id])
  trade          Trade?        @relation(fields: [tradeId], references: [id])
}
